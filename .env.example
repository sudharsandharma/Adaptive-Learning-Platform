# Backend Configuration (server/.env or Vercel Project Environment Variables)
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/nomad?retryWrites=true&w=majority
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
NODE_ENV=production

# Frontend Configuration (client/.env)
# On Vercel (same-domain services deployment), VITE_API_URL can be omitted or set to '/api'
VITE_API_URL=/api

